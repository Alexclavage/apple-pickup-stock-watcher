# Apple Stock Watcher — example environment (copy to .env)
CHECK_INTERVAL=300
DISCORD_WEBHOOK=

# For controlled local tests, suppress Discord messages even if a webhook exists.
# WATCHER_DISABLE_DISCORD=1

# The dashboard has no built-in authentication and stays local by default.
# Only set WATCHER_HOST=0.0.0.0 behind a firewall or authenticated reverse proxy.
# WATCHER_HOST=127.0.0.1
PORT=8080

WATCHER_CONFIG=config.json
STATE_FILE=state.json
HISTORY_FILE=history.json
HISTORY_MAX_EVENTS=500
