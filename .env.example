CHECK_INTERVAL=300
DISCORD_WEBHOOK=
STATE_FILE=state.json
WATCHER_CONFIG=config.json
# By default the dashboard listens only on 127.0.0.1. Set WATCHER_HOST=0.0.0.0
# only behind a local firewall/reverse proxy or a protected hosting setup.
# WATCHER_HOST=127.0.0.1
PORT=8080
HISTORY_FILE=history.json
HISTORY_MAX_EVENTS=500
